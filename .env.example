# ChainLancer Environment Configuration

# Deployment — REQUIRED for testnet deployment
# Private key of the deployer account (must have Base Sepolia ETH)
DEPLOYER_PRIVATE_KEY=

# RPC URL for Base Sepolia (the public endpoint works but can be slow)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: override the deployer address for admin/treasury roles
PLATFORM_ADMIN_ADDRESS=
TREASURY_ADDRESS=

# Etherscan / BaseScan Verification — REQUIRED for contract verification
BASESCAN_API_KEY=

# Gas Reporting (development only)
REPORT_GAS=false

# ── Contract Addresses (set after running deploy:base-sepolia) ──
# These are used by scripts/verify.ts
USDC_ADDRESS=
DATA_AVAILABILITY_ADDRESS=
REPUTATION_ADDRESS=
DISPUTE_ADDRESS=
JOB_ESCROW_ADDRESS=

# Pinata (IPFS) — only needed if running scripts that upload
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY_URL=
