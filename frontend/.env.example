# ── Pinata IPFS (required for IPFS upload/retrieval) ──
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ── Target Network ──
# Options: base-sepolia | hardhat | sepolia
VITE_TARGET_NETWORK=base-sepolia

# ── Test Mode ──
# Set to "true" ONLY for local Hardhat testing with evm_increaseTime.
# Do NOT enable for testnet or production deployments.
# VITE_TEST_MODE=true

# ── Contract Addresses (set after deploying to your target network) ──
VITE_MOCK_USDC_ADDRESS=
VITE_JOB_ESCROW_ADDRESS=
VITE_DISPUTE_ADDRESS=
VITE_REPUTATION_ADDRESS=
VITE_DATA_AVAILABILITY_ADDRESS=
